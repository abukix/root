---
/**
 * Homepage — the new /root landing.
 *
 * v0.1.0 state:
 *   - hero re-framed as "the build guide for basecamp"
 *   - CTAs point to basecamp + Program section (real destinations)
 *   - "the bet" preserved (patterns not tools)
 *   - what-ships section teases basecamp's 8 modules
 *   - status section acknowledges v0.1.0 state honestly
 *
 * Post-v0.2.0 sections will land as content ports in:
 *   - link to Master Plan
 *   - 5-thematic-years showcase
 *   - full basecamp module walkthrough
 *   - devices/homelab grid
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="root">
  <!-- Hero -->
  <section
    class="relative isolate min-h-[calc(100vh-4rem)] flex items-center justify-center px-6 overflow-hidden"
  >
    <!-- Background: gradient blobs + grid pattern -->
    <div class="absolute inset-0 -z-10 grid-bg">
      <div
        class="absolute top-1/3 left-1/4 w-[600px] h-[600px] bg-accent-purple/15 rounded-full blur-[120px]"
      >
      </div>
      <div
        class="absolute bottom-1/4 right-1/4 w-[500px] h-[500px] bg-accent-blue/15 rounded-full blur-[120px]"
      >
      </div>
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[400px] bg-accent-orange/10 rounded-full blur-[150px]"
      >
      </div>
    </div>

    <div class="max-w-5xl mx-auto text-center">
      <!-- Eyebrow pill -->
      <div class="pill mb-8 animate-fade-in">
        <span class="w-1.5 h-1.5 rounded-full bg-accent-green animate-pulse"></span>
        A curriculum, openly authored
      </div>

      <!-- Headline -->
      <h1
        class="text-5xl md:text-7xl lg:text-8xl font-bold mb-8 leading-[1.05] tracking-tight animate-fade-in-up"
      >
        <span class="block text-ink">The build guide for</span>
        <span class="block text-gradient">basecamp</span>
      </h1>

      <!-- Subhead -->
      <p
        class="text-lg md:text-xl text-ink-muted max-w-3xl mx-auto mb-12 leading-relaxed animate-fade-in-up"
        style="animation-delay: 0.1s"
      >
        Learn end-to-end platform engineering by building the stack that frontier data platforms use — <span class="root-brand">/root</span>'s 5 arcs produce <a href="https://github.com/abukix/basecamp" class="text-ink hover:text-gradient transition-colors">basecamp</a>, an open-source unified data + ML + AI platform. On your laptop, homelab, or cloud.
      </p>

      <!-- CTAs -->
      <div
        class="flex flex-col sm:flex-row gap-4 justify-center mb-16 animate-fade-in-up"
        style="animation-delay: 0.2s"
      >
        <a href="/program/" class="btn-primary">
          Read the program
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M13 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a href="https://github.com/abukix/basecamp" class="btn-secondary">See basecamp</a>
      </div>

      <!-- Stats strip -->
      <div
        class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-3xl mx-auto pt-12 border-t border-border animate-fade-in-up"
        style="animation-delay: 0.3s"
      >
        <div class="text-center">
          <div class="text-3xl md:text-4xl font-bold text-ink mb-1">5</div>
          <div class="text-xs uppercase tracking-wider text-ink-subtle">Progression arcs</div>
        </div>
        <div class="text-center">
          <div class="text-3xl md:text-4xl font-bold text-ink mb-1">50</div>
          <div class="text-xs uppercase tracking-wider text-ink-subtle">Phases</div>
        </div>
        <div class="text-center">
          <div class="text-3xl md:text-4xl font-bold text-ink mb-1">75</div>
          <div class="text-xs uppercase tracking-wider text-ink-subtle">Patterns</div>
        </div>
        <div class="text-center">
          <div class="text-3xl md:text-4xl font-bold text-ink mb-1">8</div>
          <div class="text-xs uppercase tracking-wider text-ink-subtle">basecamp modules</div>
        </div>
      </div>
    </div>
  </section>

  <!-- The bet section -->
  <section class="py-24 px-6 border-t border-border">
    <div class="max-w-4xl mx-auto text-center">
      <div class="pill mb-6">
        <span class="text-ink-muted">The bet</span>
      </div>
      <h2 class="text-3xl md:text-5xl font-bold mb-6 leading-tight">
        Tools change every 5 years.<br />
        <span class="text-ink-muted">Patterns don't change in 30.</span>
      </h2>
      <p class="text-lg text-ink-muted leading-relaxed max-w-2xl mx-auto">
        Great engineers reason in patterns, not tools. <span class="root-brand"
          >/root</span
        > builds that reflex from the first phase — pattern first, tool second, so
        when the tool changes the reflex still fires.
      </p>
    </div>
  </section>

  <!-- What ships -->
  <section class="py-24 px-6 border-t border-border">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <div class="pill mb-6">
          <span class="text-ink-muted">What gets built</span>
        </div>
        <h2 class="text-3xl md:text-5xl font-bold mb-6 leading-tight">
          <span class="text-ink">The 5 arcs produce</span><br />
          <span class="text-gradient">basecamp</span>
        </h2>
        <p class="text-lg text-ink-muted max-w-2xl mx-auto leading-relaxed">
          8 modules on a K8s substrate. Each with its own repo, its own release cadence, its own visual identity. All composing into one unified platform.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto">
        <a href="https://github.com/abukix/ascent" class="module-card">
          <img class="module-mark" src="/module-icons/ascent.svg" alt="" width="48" height="48" />
          <div class="module-name">ascent</div>
          <div class="module-desc">Developer CLI + operator</div>
        </a>
        <a href="https://github.com/abukix/crag" class="module-card">
          <img class="module-mark" src="/module-icons/crag.svg" alt="" width="48" height="48" />
          <div class="module-name">crag</div>
          <div class="module-desc">Data tier — Iceberg + Trino</div>
        </a>
        <a href="https://github.com/abukix/vantage" class="module-card">
          <img class="module-mark" src="/module-icons/vantage.svg" alt="" width="48" height="48" />
          <div class="module-name">vantage</div>
          <div class="module-desc">The unified UI</div>
        </a>
        <a href="https://github.com/abukix/beacon" class="module-card">
          <img class="module-mark" src="/module-icons/beacon.svg" alt="" width="48" height="48" />
          <div class="module-name">beacon</div>
          <div class="module-desc">On-call triage</div>
        </a>
        <a href="https://github.com/abukix/forge" class="module-card">
          <img class="module-mark" src="/module-icons/forge.svg" alt="" width="48" height="48" />
          <div class="module-name">forge</div>
          <div class="module-desc">Terraform + Crossplane</div>
        </a>
        <a href="https://github.com/abukix/prism" class="module-card">
          <img class="module-mark" src="/module-icons/prism.svg" alt="" width="48" height="48" />
          <div class="module-name">prism</div>
          <div class="module-desc">LLM gateway</div>
        </a>
        <a href="https://github.com/abukix/loom" class="module-card">
          <img class="module-mark" src="/module-icons/loom.svg" alt="" width="48" height="48" />
          <div class="module-name">loom</div>
          <div class="module-desc">MCP server fabric</div>
        </a>
        <a href="https://github.com/abukix/warden" class="module-card">
          <img class="module-mark" src="/module-icons/warden.svg" alt="" width="48" height="48" />
          <div class="module-name">warden</div>
          <div class="module-desc">AIOps operator</div>
        </a>
      </div>

      <div class="text-center mt-12">
        <a
          href="https://github.com/abukix/basecamp"
          class="text-ink-muted hover:text-ink transition-colors inline-flex items-center gap-2"
        >
          Full architecture
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M13 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Current state -->
  <section class="py-24 px-6 border-t border-border">
    <div class="max-w-4xl mx-auto text-center">
      <div class="pill mb-6">
        <span class="text-ink-muted">Current state — v0.1.0</span>
      </div>
      <h2 class="text-3xl md:text-4xl font-bold mb-6 leading-tight text-ink">
        The full curriculum is authored.<br />
        <span class="text-ink-muted">basecamp gets built as you go.</span>
      </h2>
      <p class="text-lg text-ink-muted leading-relaxed max-w-2xl mx-auto mb-8">
        <span class="root-brand">/root</span> ships with all 7 Program docs and all 5 Arcs authored — 50 phase docs across Software Engineering Foundations, Backend Engineering, Infrastructure & Platform Engineering, Data Engineering & ML Foundations, and AI Infrastructure. Read what's here; work at your own pace.
      </p>
      <p class="text-sm text-ink-subtle">
        Next milestones: Pattern library shell (v0.2.0) · Project plans + homelab guide + meta templates (v0.3.0) · Pattern deepening (v0.4.0+)
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  @reference "../styles/base.css";

  .module-card {
    @apply flex flex-col items-center justify-center p-6 rounded-xl border border-border bg-bg-subtle hover:border-accent-purple/50 hover:bg-bg-subtle/80 transition-all;
  }
  .module-mark {
    @apply w-12 h-12 rounded-lg mb-3;
  }
  .module-name {
    @apply font-semibold text-ink text-lg mb-1;
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
  }
  .module-desc {
    @apply text-xs text-ink-subtle text-center;
  }
</style>
