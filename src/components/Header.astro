---
/**
 * Header — fixed top nav.
 *
 * v0.1.0 state: minimal nav. `basecamp` link (external) + Changelog + theme toggle + GitHub.
 * As content ports in (v0.2.0+), the nav expands with Program, Patterns, Projects, Releases.
 */

const trailingLinks = [
  { href: '/program/', label: 'Program', external: false },
  { href: 'https://github.com/abukix/basecamp', label: 'basecamp', external: true },
  { href: 'https://github.com/abukix/root/blob/main/CHANGELOG.md', label: 'Changelog', external: true },
];
---

<header
  class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md bg-bg/80 border-b border-border"
>
  <nav class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
    <!-- Brand -->
    <a href="/" class="flex items-center gap-2 hover:opacity-80 transition-opacity">
      <svg
        class="brand-mark"
        width="24"
        height="24"
        viewBox="0 0 64 64"
        aria-hidden="true"
      >
        <rect width="64" height="64" rx="10"></rect>
        <path d="M 46 12 L 26 52 L 18 52 L 38 12 Z"></path>
      </svg>
      <span class="font-mono font-semibold text-xl tracking-tight text-ink">root</span>
    </a>

    <!-- Section links -->
    <div class="hidden md:flex items-center gap-8">
      {
        trailingLinks.map((link) => (
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener' : undefined}
            class="text-sm font-medium text-ink-muted hover:text-ink transition-colors"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <!-- Right side: theme toggle + GitHub -->
    <div class="flex items-center gap-4">
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle theme"
        class="text-ink-muted hover:text-ink transition-colors"
      >
        <svg
          class="theme-icon-sun"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <svg
          class="theme-icon-moon"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>

      <a
        href="https://github.com/abukix/root"
        target="_blank"
        rel="noopener"
        class="text-ink-muted hover:text-ink transition-colors"
        aria-label="GitHub"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
      </a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('theme-toggle');
  toggle?.addEventListener('click', () => {
    const isLight = document.documentElement.getAttribute('data-theme') === 'light';
    if (isLight) {
      document.documentElement.removeAttribute('data-theme');
      localStorage.setItem('theme', 'dark');
    } else {
      document.documentElement.setAttribute('data-theme', 'light');
      localStorage.setItem('theme', 'light');
    }
  });
</script>
