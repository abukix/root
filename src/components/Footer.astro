---
/**
 * Footer — minimal 3-column layout for v0.1.0.
 *
 * v0.1.0 state:
 *   col 1: brand + tagline + social
 *   col 2: The family — basecamp, module repos, Arc 1 tools
 *   col 3: External — GitHub, Changelog
 *
 * As internal content ports in (v0.2.0+), Program / Resources columns
 * (Overview, Capstone, Story, Pattern Library, etc.) will land here.
 *
 * Version is read from package.json so bumping the release automatically
 * updates the footer. Discipline: bump package.json alongside CHANGELOG.md
 * (or use `npm version patch|minor|major`, which does it in one step).
 */

import pkg from '../../package.json';
const version = pkg.version;

const familyLinks = [
  { href: 'https://github.com/abukix/basecamp', label: 'basecamp' },
  { href: 'https://github.com/abukix/sift', label: 'sift' },
  { href: 'https://github.com/abukix/pulse', label: 'pulse' },
];

const externalLinks = [
  { href: 'https://github.com/abukix/root', label: 'GitHub' },
  { href: 'https://github.com/abukix/root/blob/main/CHANGELOG.md', label: 'Changelog' },
  { href: 'https://github.com/abukix/root/blob/main/LICENSE', label: 'License' },
];
---

<footer class="border-t border-border bg-bg-subtle">
  <div class="max-w-7xl mx-auto px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Col 1: Brand -->
      <div>
        <div class="flex items-center gap-2 mb-4">
          <svg
            class="brand-mark"
            width="20"
            height="20"
            viewBox="0 0 64 64"
            aria-hidden="true"
          >
            <rect width="64" height="64" rx="10"></rect>
            <path d="M 46 12 L 26 52 L 18 52 L 38 12 Z"></path>
          </svg>
          <span class="font-mono font-semibold text-lg text-ink">root</span>
        </div>
        <p class="text-sm text-ink-muted leading-relaxed mb-6">
          The build guide for <a href="https://github.com/abukix/basecamp" class="text-ink-muted hover:text-ink transition-colors underline-offset-2 hover:underline">basecamp</a>. Learn end-to-end platform engineering by building the stack that frontier data platforms use, at your own scale.
        </p>
        <div class="flex items-center gap-3">
          <a
            href="https://github.com/abukix/root"
            target="_blank"
            rel="noopener"
            class="p-2 rounded-full border border-border text-ink-muted hover:text-ink hover:border-ink transition-colors"
            aria-label="GitHub"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Col 2: The family -->
      <div>
        <h4 class="text-sm font-semibold text-ink mb-4">The family</h4>
        <ul class="space-y-3 text-sm text-ink-muted">
          {
            familyLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener"
                  class="hover:text-ink transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 3: External -->
      <div>
        <h4 class="text-sm font-semibold text-ink mb-4">Resources</h4>
        <ul class="space-y-3 text-sm text-ink-muted">
          {
            externalLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener"
                  class="hover:text-ink transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      class="mt-16 pt-8 border-t border-border flex flex-col md:flex-row justify-between items-center gap-4"
    >
      <p class="text-sm text-ink-subtle">
        Built by <a
          href="https://abukix.dev"
          class="text-ink-muted hover:text-ink transition-colors">JC Abucay</a
        >. Apache 2.0 licensed.
      </p>
      <p class="text-sm text-ink-subtle">v{version} · scaffold shipped</p>
    </div>
  </div>
</footer>
